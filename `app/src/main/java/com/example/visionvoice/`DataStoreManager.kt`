package com.example.visionvoice

import android.content.Context
import androidx.datastore.core.DataStore
import androidx.datastore.preferences.core.*
import androidx.datastore.preferences.preferencesDataStore
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.map

val Context.dataStore: DataStore<Preferences> by preferencesDataStore(
    name = "vision_voice_prefs"
)

class DataStoreManager(private val context: Context) {

    companion object {
        val IS_ONBOARDING_DONE = booleanPreferencesKey("onboarding_done")
        val USER_NAME = stringPreferencesKey("user_name")
        val EMERGENCY_CONTACT_1 = stringPreferencesKey("emergency_contact_1")
        val TALKBACK_ENABLED = booleanPreferencesKey("talkback_enabled")

        val HIGH_CONTRAST = booleanPreferencesKey("high_contrast")
        val SPEECH_RATE = floatPreferencesKey("speech_rate")
    }

    val isOnboardingDone: Flow<Boolean> =
        context.dataStore.data.map {
            it[IS_ONBOARDING_DONE] ?: false
        }

    val emergencyContact: Flow<String> =
        context.dataStore.data.map {
            it[EMERGENCY_CONTACT_1] ?: ""
        }

    val isHighContrast: Flow<Boolean> =
        context.dataStore.data.map {
            it[HIGH_CONTRAST] ?: false
        }

    val speechRate: Flow<Float> =
        context.dataStore.data.map {
            it[SPEECH_RATE] ?: 1.0f
        }

    suspend fun setOnboardingDone(done: Boolean) {
        context.dataStore.edit {
            it[IS_ONBOARDING_DONE] = done
        }
    }

    suspend fun saveEmergencyContact(number: String) {
        context.dataStore.edit {
            it[EMERGENCY_CONTACT_1] = number
        }
    }

    suspend fun saveUserName(name: String) {
        context.dataStore.edit {
            it[USER_NAME] = name
        }
    }

    suspend fun setHighContrast(enabled: Boolean) {
        context.dataStore.edit {
            it[HIGH_CONTRAST] = enabled
        }
    }

    suspend fun setSpeechRate(rate: Float) {
        context.dataStore.edit {
            it[SPEECH_RATE] = rate
        }
    }
}
